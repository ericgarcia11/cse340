<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <h2><%= categoryDetails.name %></h2>

    <h3>Service Projects</h3>
    <ul>
        <% projectsInCategory.forEach(project => { %>
            <li><a href="/project/<%= project.project_id %>"><%= project.title %></a></li>
        <% }); %>
    </ul>
    <% if (user && user.role_name === 'admin') { %>
        <a href="/edit-category/<%= categoryDetails.category_id %>" class="btn-primary">Edit Category</a>
    <% } %>
</main>
<%- include('partials/footer') %>
