<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <h2><%= projectDetails.title %></h2>
    <p><strong>Description:</strong> <%= projectDetails.description %></p>
    <p><strong>Date:</strong> <%= new Date(projectDetails.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) %></p>
    <p><strong>Location:</strong> <%= projectDetails.location %></p>
    <p><strong>Organization:</strong> <a href="/organization/<%= projectDetails.organization_id %>"><%= projectDetails.organization_name %></a></p>
    <% if (categories && categories.length > 0) { %>
    <p><strong>Categories:</strong>
        <% categories.forEach(category => { %>
            <a href="/category/<%= category.category_id %>"><%= category.name %></a>
        <% }); %>
    </p>
    <% } %>
    <% if (user && user.role_name === 'admin') { %>
        <a href="/project/<%= projectDetails.project_id %>/assign-categories" class="btn-primary">Edit Categories</a>
        <a href="/edit-project/<%= projectDetails.project_id %>" class="btn-primary">Edit Project</a>
    <% } %>
</main>
<%- include('partials/footer') %>
