<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2><%= projectDetails.title %></h2>

    <form action="/project/<%= projectDetails.project_id %>/assign-categories" method="POST">
        <fieldset>
            <legend>Select Categories</legend>
            <% allCategories.forEach(category => { %>
                <div class="form-check">
                    <input
                        type="checkbox"
                        id="category-<%= category.category_id %>"
                        name="categoryIds"
                        value="<%= category.category_id %>"
                        <% if (assignedCategories.some(c => c.category_id === category.category_id)) { %>checked<% } %>
                    />
                    <label for="category-<%= category.category_id %>"><%= category.name %></label>
                </div>
            <% }); %>
        </fieldset>

        <button type="submit">Save Categories</button>
    </form>
</main>
<%- include('partials/footer') %>
